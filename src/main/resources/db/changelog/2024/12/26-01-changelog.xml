<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1735221304853-1" author="Irina.Lovtsova">
        <createTable tableName="sport_school_rating">
            <column name="school_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="rating" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1735221304853-2" author="Irina.Lovtsova">
        <addForeignKeyConstraint baseColumnNames="school_id" baseTableName="sport_school_rating"
                                 constraintName="fk_sport_school_rating_on_sport_school" referencedColumnNames="id"
                                 referencedTableName="sport_school"/>
    </changeSet>

</databaseChangeLog>