<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1750933656713-1" author="Irina.Lovtsova">
        <createSequence incrementBy="1" sequenceName="competition_id_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1750933656713-2" author="Irina.Lovtsova">
        <createTable tableName="award">
            <column name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_award"/>
            </column>
            <column name="award_year" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="award_title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="winner_id" type="INT"/>
        </createTable>
    </changeSet>
    <changeSet id="1750933656713-3" author="Irina.Lovtsova">
        <createTable tableName="competition">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_competition"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="competition_level" type="SMALLINT"/>
            <column name="referee_id" type="INT"/>
            <column name="first_player_id" type="INT"/>
            <column name="second_player_id" type="INT"/>
            <column name="city" type="VARCHAR(255)"/>
            <column name="stadium" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1750933656713-4" author="Irina.Lovtsova">
        <createTable tableName="license">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_license"/>
            </column>
            <column name="license_num" type="VARCHAR(255)"/>
            <column name="serial_num" type="INT"/>
            <column name="descr" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1750933656713-5" author="Irina.Lovtsova">
        <createTable tableName="player">
            <column name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_player"/>
            </column>
            <column name="full_name" type="VARCHAR(255)"/>
            <column name="rating" type="INT"/>
        </createTable>
    </changeSet>
    <changeSet id="1750933656713-6" author="Irina.Lovtsova">
        <createTable tableName="player_sport_school">
            <column name="player_id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_playersportschool"/>
            </column>
            <column name="sport_school_id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_playersportschool"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1750933656713-7" author="Irina.Lovtsova">
        <createTable tableName="referee">
            <column name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_referee"/>
            </column>
            <column name="full_name" type="VARCHAR(255)"/>
            <column name="license_id" type="BIGINT"/>
        </createTable>
    </changeSet>
    <changeSet id="1750933656713-8" author="Irina.Lovtsova">
        <createTable tableName="sport_school">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_sportschool"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1750933656713-9" author="Irina.Lovtsova">
        <createTable tableName="sport_school_rating">
            <column name="school_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="rating" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1750933656713-10" author="Irina.Lovtsova">
        <addUniqueConstraint columnNames="license_num" constraintName="licenseNumUniq" tableName="license"/>
    </changeSet>
    <changeSet id="1750933656713-11" author="Irina.Lovtsova">
        <addUniqueConstraint columnNames="license_id" constraintName="uc_referee_licenseid" tableName="referee"/>
    </changeSet>
    <changeSet id="1750933656713-13" author="Irina.Lovtsova">
        <addForeignKeyConstraint baseColumnNames="winner_id" baseTableName="award" constraintName="FK_AWARD_ON_WINNERID"
                                 referencedColumnNames="id" referencedTableName="player"/>

        <createIndex indexName="winnerIdIdx" tableName="award">
            <column name="winner_id"/>
        </createIndex>
    </changeSet>
    <changeSet id="1750933656713-14" author="Irina.Lovtsova">
        <addForeignKeyConstraint baseColumnNames="first_player_id" baseTableName="competition"
                                 constraintName="FK_COMPETITION_ON_FIRSTPLAYERID" referencedColumnNames="id"
                                 referencedTableName="player"/>
    </changeSet>
    <changeSet id="1750933656713-15" author="Irina.Lovtsova">
        <addForeignKeyConstraint baseColumnNames="referee_id" baseTableName="competition"
                                 constraintName="FK_COMPETITION_ON_REFEREEID" referencedColumnNames="id"
                                 referencedTableName="referee"/>
    </changeSet>
    <changeSet id="1750933656713-16" author="Irina.Lovtsova">
        <addForeignKeyConstraint baseColumnNames="second_player_id" baseTableName="competition"
                                 constraintName="FK_COMPETITION_ON_SECONDPLAYERID" referencedColumnNames="id"
                                 referencedTableName="player"/>
    </changeSet>
    <changeSet id="1750933656713-17" author="Irina.Lovtsova">
        <addForeignKeyConstraint baseColumnNames="license_id" baseTableName="referee"
                                 constraintName="FK_REFEREE_ON_LICENSEID" referencedColumnNames="id"
                                 referencedTableName="license"/>
    </changeSet>
    <changeSet id="1750933656713-18" author="Irina.Lovtsova">
        <addForeignKeyConstraint baseColumnNames="player_id" baseTableName="player_sport_school"
                                 constraintName="fk_plasposch_on_player" referencedColumnNames="id"
                                 referencedTableName="player"/>
    </changeSet>
    <changeSet id="1750933656713-19" author="Irina.Lovtsova">
        <addForeignKeyConstraint baseColumnNames="sport_school_id" baseTableName="player_sport_school"
                                 constraintName="fk_plasposch_on_sport_school" referencedColumnNames="id"
                                 referencedTableName="sport_school"/>
    </changeSet>
    <changeSet id="1750933656713-20" author="Irina.Lovtsova">
        <addForeignKeyConstraint baseColumnNames="school_id" baseTableName="sport_school_rating"
                                 constraintName="fk_sportschoolrating_on_sport_school" referencedColumnNames="id"
                                 referencedTableName="sport_school"/>
    </changeSet>

</databaseChangeLog>